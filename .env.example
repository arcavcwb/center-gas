# =============================================================================
# Center Gás Curitiba — Plantilla de variables de entorno
# =============================================================================
#
# Uso:   cp .env.example .env   y rellena los valores reales.
#
# ⚠️  El archivo .env está en .gitignore. NUNCA lo commitees, y NUNCA pegues
#     valores reales en este .env.example, en un .md, en un script .py/.js ni en
#     un JSON de workflow de n8n. Este repositorio es PÚBLICO.
#     Contexto: docs/SECURITY-INCIDENT-2026-09.md
#
# Convención de marcas usada en todo el archivo:
#   🌐 PÚBLICA  → se compila dentro del bundle y viaja al navegador (o es un
#                 identificador no sensible). No es un secreto: cualquiera puede
#                 leerla. La protección real es RLS en Supabase.
#   🔒 SECRETA  → solo servidor / CI / VPS. Si se filtra, hay que rotarla.
#
# Ningún valor de este archivo es real: todos son marcadores.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SUPABASE — apps/site (Astro + SolidJS: catálogo B2C y app del motoboy)
#    Astro solo expone al navegador las variables con prefijo PUBLIC_.
#    Consumidas en: apps/site/src/lib/supabase.ts (import.meta.env)
# -----------------------------------------------------------------------------

# 🌐 PÚBLICA — URL del proyecto Supabase
PUBLIC_SUPABASE_URL=https://tu-project-ref.supabase.co

# 🌐 PÚBLICA — clave anónima (rol `anon`). Solo puede hacer lo que permita RLS.
PUBLIC_SUPABASE_ANON_KEY=<REEMPLAZAR-POR-LA-ANON-KEY>


# -----------------------------------------------------------------------------
# 2. SUPABASE — apps/web (Next.js 15: panel B2B del dueño)
#    Next.js solo expone al navegador las variables con prefijo NEXT_PUBLIC_.
#    Consumidas en: apps/web/src/lib/supabase.ts, apps/web/src/middleware.ts
# -----------------------------------------------------------------------------

# 🌐 PÚBLICA — mismo valor que PUBLIC_SUPABASE_URL, con el prefijo de Next.js
NEXT_PUBLIC_SUPABASE_URL=https://tu-project-ref.supabase.co

# 🌐 PÚBLICA — mismo valor que PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=<REEMPLAZAR-POR-LA-ANON-KEY>


# -----------------------------------------------------------------------------
# 3. SUPABASE — credenciales de servidor
#    ⚠️ NUNCA les pongas el prefijo PUBLIC_ / NEXT_PUBLIC_: las publicarías.
# -----------------------------------------------------------------------------

# 🔒 SECRETA — rol `service_role`: OMITE TODAS LAS POLÍTICAS RLS.
# Equivale a acceso total de lectura/escritura a la base de datos.
# Solo en: scripts de administración, workflows de n8n y código de servidor.
# Consumida en: apps/web/scripts/create_owner.js, apps/web/scripts/create_driver.js,
#               scripts/test-e2e-whatsapp-lifecycle.js, test_rpc.js,
#               push_local_n8n.py, workflows/n8n/*
SUPABASE_SERVICE_ROLE_KEY=<REEMPLAZAR-POR-LA-SERVICE-ROLE-KEY>

# 🔒 SECRETA — cadena de conexión directa a Postgres (incluye la contraseña).
# Se usa para migraciones y tests de base de datos en el pipeline.
# ⚠️ Verifica que el `project-ref` de esta URL sea el MISMO proyecto Supabase que
#    PUBLIC_SUPABASE_URL. Ver "Pregunta abierta" en docs/SECURITY-INCIDENT-2026-09.md.
SUPABASE_DB_URL=postgresql://postgres.tu-project-ref:TU_PASSWORD_DE_POSTGRES@aws-0-tu-region.pooler.supabase.com:5432/postgres

# 🌐 PÚBLICA — alias sin prefijo, usado por los nodos de n8n ({{ $env.SUPABASE_URL }})
# y por push_local_n8n.py. Mismo valor que PUBLIC_SUPABASE_URL; se declara aparte
# porque n8n y los scripts .py no conocen los prefijos de Astro/Next.
SUPABASE_URL=https://tu-project-ref.supabase.co


# -----------------------------------------------------------------------------
# 4. CUENTAS DE BOOTSTRAP (creación del primer owner y del primer motoboy)
#    Consumidas en: apps/web/scripts/create_owner.js y create_driver.js
#    Los scripts abortan si faltan: no hay contraseñas por defecto.
# -----------------------------------------------------------------------------

# 🌐 PÚBLICA — email del administrador del panel B2B
OWNER_EMAIL=admin@tu-dominio.com

# 🔒 SECRETA — contraseña del administrador (mínimo 12 caracteres).
# Genérala aleatoria y guárdala en un gestor de contraseñas, no aquí.
OWNER_PASSWORD=

# 🌐 PÚBLICA — email del motoboy de prueba
DRIVER_EMAIL=motoboy1@tu-dominio.com

# 🔒 SECRETA — contraseña del motoboy (mínimo 12 caracteres)
DRIVER_PASSWORD=

# 🌐 PÚBLICA — teléfono del cliente ficticio que el seed del motoboy crea
SEED_CUSTOMER_PHONE=5541999999999


# -----------------------------------------------------------------------------
# 5. n8n — orquestación de automatizaciones (workflows/n8n/*.json)
# -----------------------------------------------------------------------------

# 🌐 PÚBLICA — URL base de la API REST de n8n (la usan los scripts .js)
N8N_API_URL=https://n8n.tu-dominio.com

# 🌐 PÚBLICA — misma instancia, nombre que usan los scripts .py
N8N_BASE_URL=https://n8n.tu-dominio.com

# 🔒 SECRETA — API key de n8n (JWT). Permite crear, modificar y borrar workflows.
# Consumida en: deploy_n8n_workflows.py, push_local_n8n.py,
#               scripts/test-e2e-whatsapp-lifecycle.js
N8N_API_KEY=<REEMPLAZAR-POR-LA-API-KEY-DE-N8N>

# 🔒 SECRETA — token Bearer compartido entre Supabase y n8n. La función
# net.http_post() de las migraciones lo envía en la cabecera Authorization y el
# nodo "Validate Token" del WF-02 lo valida; si no coincide, el flujo se descarta.
# Genera un valor aleatorio largo (por ejemplo: openssl rand -hex 32).
# Del lado de Supabase el token ya NO vive en el SQL: se guarda en la tabla
# `system_config` (clave `n8n_webhook_token`). Esta variable es la copia que
# necesitan el script E2E y el nodo "Validate Token" de n8n; los tres valores
# (system_config, n8n y este .env) tienen que coincidir.
SECURE_OUTBOUND_TOKEN=<REEMPLAZAR-POR-UN-TOKEN-ALEATORIO-LARGO>

# 🌐 PÚBLICA — ID del workflow que actualiza push_local_n8n.py
N8N_WORKFLOW_ID=

# 🌐 PÚBLICA — ruta opcional a un bundle de CA propio, si tu n8n usa un
# certificado autofirmado. Déjala vacía para usar la verificación TLS estándar.
N8N_CA_BUNDLE=


# -----------------------------------------------------------------------------
# 6. EVOLUTION API — pasarela de WhatsApp (consumida por n8n vía {{ $env.* }})
# -----------------------------------------------------------------------------

# 🌐 PÚBLICA — URL de la instancia de Evolution API v2
EVOLUTION_API_URL=https://evolution.tu-dominio.com

# 🔒 SECRETA — API key de Evolution (cabecera `apikey`). Quien la tenga puede
# enviar mensajes de WhatsApp en nombre del negocio y leer conversaciones.
# Debe coincidir con AUTHENTICATION_API_KEY del docker-compose del VPS (sección 11).
EVOLUTION_API_KEY=<REEMPLAZAR-POR-LA-API-KEY-DE-EVOLUTION>

# 🌐 PÚBLICA — nombre de la instancia (el "chip" de WhatsApp conectado)
EVOLUTION_INSTANCE_NAME=centerGas

# 🔒 SECRETA — token Bearer compartido entre Evolution API y n8n. Evolution lo
# envía en la cabecera Authorization del webhook entrante y el nodo
# "Validate Token" del WF-01 lo valida; si no coincide, el flujo se descarta.
# Sin él, la URL pública /webhook/evolution-inbound deja que cualquiera dispare
# envíos de WhatsApp desde el chip del negocio (baneo seguro de Meta).
# Genera un valor aleatorio largo (por ejemplo: openssl rand -hex 32).
# Consumida en: workflows/n8n/WF-01_WhatsApp_Inbound.json (nodo "Validate Token"),
#               scripts/test-e2e-whatsapp-lifecycle.js (fase 1, webhook inbound)
#               y la configuración de webhook de Evolution API.
EVOLUTION_WEBHOOK_TOKEN=<REEMPLAZAR-POR-UN-TOKEN-ALEATORIO-LARGO>

# 🔒 SECRETA — número de WhatsApp del dueño, destino de las alertas del
# WF-04 (Global Error Handler). Formato internacional sin "+": 55DDNNNNNNNNN.
# TODO: rellenar con el número real del dueño; no versionarlo nunca.
OWNER_WHATSAPP_NUMBER=


# -----------------------------------------------------------------------------
# 7. CATÁLOGO B2C — dominio que n8n envía a los clientes por WhatsApp
# -----------------------------------------------------------------------------

# 🌐 PÚBLICA — dominio sin protocolo, para construir el enlace del catálogo
CATALOG_DOMAIN=tu-catalogo.vercel.app

# 🌐 PÚBLICA — misma URL, con protocolo
CATALOG_URL=https://tu-catalogo.vercel.app


# -----------------------------------------------------------------------------
# 8. PLANE.SO — gestión de issues del flujo agéntico (scripts .py de la raíz
#    y .agents/mcp_config.json)
# -----------------------------------------------------------------------------

# 🔒 SECRETA — API key de Plane: lectura y escritura de issues, comentarios y ciclos
PLANE_API_KEY=<REEMPLAZAR-POR-LA-API-KEY-DE-PLANE>

# 🌐 PÚBLICA — slug del workspace (nombre usado por los scripts .py)
PLANE_WORKSPACE=tu-workspace

# 🌐 PÚBLICA — mismo slug, nombre usado por .github/scripts/run-agent.js y el MCP
PLANE_WORKSPACE_SLUG=tu-workspace

# 🌐 PÚBLICA — UUID del proyecto en Plane
PLANE_PROJECT_ID=00000000-0000-0000-0000-000000000000

# 🌐 PÚBLICA — URL base de la API de Plane
PLANE_BASE_URL=https://api.plane.so

# 🌐 PÚBLICA — UUID del estado "Done" del proyecto (lo usa sync_plane.py)
PLANE_DONE_STATE_ID=00000000-0000-0000-0000-000000000000

# 🌐 PÚBLICA — UUID del ciclo/sprint activo (lo usa sync_plane.py)
PLANE_CYCLE_ID=00000000-0000-0000-0000-000000000000


# -----------------------------------------------------------------------------
# 9. CI / GITHUB ACTIONS (.github/workflows/*.yml, .github/scripts/run-agent.js)
#    En CI se configuran como GitHub Secrets, no en un .env.
# -----------------------------------------------------------------------------

# 🔒 SECRETA — API key de Gemini, usada por el agente revisor de Pull Requests
GEMINI_API_KEY=reemplazar_por_la_api_key_de_gemini

# 🔒 SECRETA — token de GitHub. En Actions lo inyecta la plataforma como
# ${{ secrets.GITHUB_TOKEN }}; solo se define a mano para ejecutar el agente en local.
GITHUB_TOKEN=


# -----------------------------------------------------------------------------
# 10. TESTS (apps/e2e con Playwright, test_rpc.js y el E2E de WhatsApp)
# -----------------------------------------------------------------------------

# 🌐 PÚBLICA — URL contra la que corren los tests de Playwright
E2E_BASE_URL=http://localhost:3000

# 🌐 PÚBLICA — la define el runner de CI; no hace falta ponerla en local.
# CI=true

# 🌐 PÚBLICA — interruptor de seguridad. Los scripts que ESCRIBEN en la base de
# datos (test_rpc.js, scripts/test-e2e-whatsapp-lifecycle.js) abortan si no vale
# exactamente "1". Actívalo solo apuntando a un entorno de staging, nunca a producción.
# ALLOW_DESTRUCTIVE_TEST=1

# 🌐 PÚBLICA — teléfono ficticio usado por test_rpc.js
TEST_PHONE=5541999999999


# -----------------------------------------------------------------------------
# 11. HERRAMIENTAS DE DESARROLLO (opcionales, solo para el equipo agéntico)
#     Consumidas por .agents/skills/caveman-compress/scripts/compress.py
# -----------------------------------------------------------------------------

# 🔒 SECRETA — opcional. Si no está definida, la skill usa el CLI de Claude.
# ANTHROPIC_API_KEY=

# 🌐 PÚBLICA — modelo por defecto de la skill de compresión
# CAVEMAN_MODEL=claude-sonnet-4-5


# -----------------------------------------------------------------------------
# 12. INFRAESTRUCTURA DEL VPS (Evolution API self-hosted)
#     Estas variables NO van en este .env: viven en el VPS, junto al
#     docker-compose. Se listan aquí solo como índice.
#     Plantilla real: infrastructure/evolution-api/.env.example
#
#       SERVER_URL              🌐 PÚBLICA — URL pública de la instancia
#       AUTHENTICATION_API_KEY  🔒 SECRETA — mismo valor que EVOLUTION_API_KEY
#       POSTGRES_USER           🌐 PÚBLICA — usuario del Postgres de Evolution
#       POSTGRES_PASSWORD       🔒 SECRETA — contraseña de ese Postgres
#       POSTGRES_DB             🌐 PÚBLICA — nombre de la base de datos
# -----------------------------------------------------------------------------
