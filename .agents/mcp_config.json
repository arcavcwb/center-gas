{
  "mcpServers": {
    "plane": {
      "command": "npx",
      "args": ["-y", "@makeplane/plane-mcp-server"],
      "env": {
        "PLANE_API_KEY": "${PLANE_API_KEY}",
        "PLANE_WORKSPACE_SLUG": "lead-flow",
        "PLANE_BASE_URL": "https://api.plane.so"
      }
    },
    "n8n": {
      "command": "npx",
      "args": ["-y", "n8n-mcp"],
      "env": {
        "N8N_API_URL": "https://n8n.arcav.us/api/v1",
        "N8N_API_KEY": "${N8N_API_KEY}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp"]
    },
    "devops-helper": {
      "command": "npx",
      "args": ["-y", "@rideRTD/RTD-DevOps"]
    },
    "supabase": {
      "serverUrl": "https://mcp.supabase.com/mcp?project_ref=fsfaqzayoziaeaihycos&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
    }
  }
}
