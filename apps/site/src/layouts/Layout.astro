---
// AVISO (codigo muerto): ningun archivo del proyecto importa este layout.
// Verificado con grep sobre apps/ y packages/: cero importaciones de
// 'layouts/Layout' o 'Layout.astro'. Aun asi, es el unico sitio donde se
// define la meta description del proyecto, asi que no se elimina por ahora.
// TODO: decidir si se cablea en las paginas reales (index.astro, 404.astro,
// driver/index.astro) o si se borra. Decision pendiente del equipo.
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Center Gás Curitiba - Gás P13 e Água Mineral no Pinheirinho",
  description = "Distribuidora de Gás de Cozinha P13 e Água Mineral 20L no Bairro Pinheirinho, Curitiba. Peça online com entrega rápida e pagamento via PIX ou Dinheiro."
} = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
