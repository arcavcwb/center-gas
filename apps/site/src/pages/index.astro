---
import Catalog from '../components/Catalog';
import '../styles/global.css';

// Horário comercial Pinheirinho (Curitiba): Seg-Sáb 08h-20h, Dom 08h-14h
const now = new Date();
const curitibaDate = new Date(now.toLocaleString('en-US', { timeZone: 'America/Sao_Paulo' }));
const curitibaHour = curitibaDate.getHours();
const curitibaDay = curitibaDate.getDay(); // 0: Dom, 1: Seg, ..., 6: Sab

const isOpen = (curitibaDay >= 1 && curitibaDay <= 6 && curitibaHour >= 8 && curitibaHour < 20) ||
               (curitibaDay === 0 && curitibaHour >= 8 && curitibaHour < 14);

// TODO(produccion): definir PUBLIC_WHATSAPP_NUMBER en las variables de entorno de
// Vercel con el numero real de la tienda ANTES de anunciar el sitio. Mientras esa
// variable no exista, el enlace de WhatsApp apunta a 5541999999999, que es un
// placeholder y NO es un numero que exista: nadie recibe esos mensajes.
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '5541999999999';
// Mensaje prellenado unico para el enlace de contacto de esta pagina
const whatsappMessage = 'Olá, gostaria de fazer um pedido na Center Gás';
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Center Gás Curitiba - Gás P13 e Água Mineral no Pinheirinho</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased min-h-screen">
    <header class="bg-white/95 backdrop-blur-md border-b border-slate-200 px-4 py-3 shadow-xs flex justify-between items-center sticky top-0 z-50">
      <div class="flex items-center gap-2.5">
        <span 
          class={`w-2.5 h-2.5 rounded-full inline-block ${isOpen ? 'bg-emerald-500 ring-4 ring-emerald-100' : 'bg-amber-500 ring-4 ring-amber-100'}`} 
          title={isOpen ? "Aberto agora (Entregas rápidas)" : "Fora do horário comercial (Entrega agendada)"}
        ></span>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="font-black text-lg tracking-tight text-slate-900">CENTER</span>
            <span class="font-black text-lg tracking-tight text-primary">GÁS</span>
          </div>
          <p class="text-xs text-slate-500 font-medium -mt-1">
            Pinheirinho • {isOpen ? 'Aberto agora' : 'Entrega agendada'}
          </p>
        </div>
      </div>
      <a 
        href={whatsappHref} 
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-bold bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200 px-3.5 py-1.5 rounded-full transition-colors flex items-center gap-1.5 shadow-xs"
        aria-label="Falar no WhatsApp"
      >
        <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        <span>WhatsApp</span>
      </a>
    </header>

    <main class="max-w-md mx-auto p-4 pb-28">
      <!-- Isla Interactiva de SolidJS con Catálogo Bilingüe y Enfoque Pinheirinho -->
      <Catalog client:load />
    </main>
  </body>
</html>
