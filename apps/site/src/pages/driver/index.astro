---
import DriverApp from '../../components/DriverApp';
import '../../styles/global.css';
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-100 text-slate-900 font-sans antialiased overflow-x-hidden min-h-screen">
    <div class="max-w-md mx-auto bg-white min-h-screen shadow-2xl relative flex flex-col">
      <header class="bg-slate-900 text-white p-4 shadow-md flex justify-between items-center sticky top-0 z-50">
        <div class="flex items-center space-x-2.5">
          <span class="w-2.5 h-2.5 bg-emerald-500 rounded-full animate-pulse motion-reduce:animate-none ring-4 ring-emerald-950"></span>
          <div>
            <h1 class="font-extrabold text-base tracking-tight leading-none">Centro de Entregas</h1>
            <p class="text-xs text-slate-400 font-medium mt-0.5">Pinheirinho • Curitiba</p>
          </div>
        </div>
        <button 
          onClick="window.location.reload()"
          class="text-xs font-semibold bg-slate-800 hover:bg-slate-700 px-3.5 py-1.5 rounded-full border border-slate-700 transition-colors cursor-pointer"
        >
          Atualizar
        </button>
      </header>

      <main class="w-full p-4 pb-32 flex-1">
        <!-- Isla Interactiva de SolidJS (UI do entregador em PT-BR) -->
        <DriverApp client:load />
      </main>
    </div>
  </body>
</html>
