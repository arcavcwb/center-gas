{
  "name": "WF-01: WhatsApp Inbound Auto-Reply",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "evolution-inbound",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-inbound",
      "name": "Webhook Evolution API",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 250, 300 ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.data.message.conversation }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "if-is-message",
      "name": "Es mensaje válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 450, 300 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/generate_catalog_session",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "p_phone",
              "value": "={{ $json.body.data.key.remoteJid.replace('@s.whatsapp.net', '') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-supabase-token",
      "name": "Generate Catalog Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 650, 300 ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "if-token-valid",
      "name": "Token generado? (Rate Limit Check)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 850, 300 ]
    },
    {
      "parameters": {
        "amount": "={{ Math.floor(Math.random() * 6) + 4 }}",
        "unit": "seconds"
      },
      "id": "wait-human-delay",
      "name": "Delay Anti-Robot (4-9s)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [ 1050, 280 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE_NAME }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $('Es mensaje válido?').item.json.body.data.key.remoteJid }}"
            },
            {
              "name": "text",
              "value": "Oi! 👋 Vi sua mensagem.\n\nAcesse o link abaixo para fazer seu pedido direto e com segurança:\n🔗 {{ $env.CATALOG_URL }}/?token={{ $('Generate Catalog Token').item.json }}\n\nO link é válido por 24 horas. Qualquer dúvida é só chamar! 😊"
            }
          ]
        },
        "options": {}
      },
      "id": "http-send-reply",
      "name": "Enviar Auto-Respuesta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 1250, 280 ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Webhook Evolution API": {
      "main": [
        [
          {
            "node": "Es mensaje válido?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Es mensaje válido?": {
      "main": [
        [
          {
            "node": "Generate Catalog Token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Catalog Token": {
      "main": [
        [
          {
            "node": "Token generado? (Rate Limit Check)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Token generado? (Rate Limit Check)": {
      "main": [
        [
          {
            "node": "Delay Anti-Robot (4-9s)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delay Anti-Robot (4-9s)": {
      "main": [
        [
          {
            "node": "Enviar Auto-Respuesta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "WF-04: Global Error Handler"
  }
}
