{
  "name": "WF-01: WhatsApp Inbound Auto-Reply",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "evolution-inbound",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-inbound",
      "name": "Webhook Evolution API",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 250, 300 ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.data.message.conversation }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "if-is-message",
      "name": "Es mensaje válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 450, 300 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/generate_catalog_session",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_ANON_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "p_phone",
              "value": "={{ $json.body.data.key.remoteJid.replace('@s.whatsapp.net', '') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-supabase-token",
      "name": "Generate Catalog Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 700, 280 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE_NAME }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $('Es mensaje válido?').item.json.body.data.key.remoteJid }}"
            },
            {
              "name": "text",
              "value": "¡Hola! 🚀 Haz tu pedido de gas rápido y seguro desde nuestro catálogo: https://APP_URL/?token={{ $json }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-send-reply",
      "name": "Enviar Auto-Respuesta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 950, 280 ]
    }
  ],
  "connections": {
    "Webhook Evolution API": {
      "main": [
        [
          {
            "node": "Es mensaje válido?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Es mensaje válido?": {
      "main": [
        [
          {
            "node": "Generate Catalog Token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Catalog Token": {
      "main": [
        [
          {
            "node": "Enviar Auto-Respuesta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
