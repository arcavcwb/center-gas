{
  "name": "WF-01: WhatsApp Inbound Auto-Reply",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "evolution-inbound",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-inbound",
      "name": "Webhook Evolution API",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 200, 300 ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.data.message?.conversation || $json.body.data.message?.extendedTextMessage?.text }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "if-is-message",
      "name": "Es mensaje válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 420, 300 ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ ($json.body.data.message?.conversation || $json.body.data.message?.extendedTextMessage?.text || '').trim().toLowerCase() }}",
              "operation": "regex",
              "value2": "^(sair|cancelar|parar|stop)$"
            }
          ]
        }
      },
      "id": "if-opt-out",
      "name": "Es comando Opt-Out (LGPD)?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 640, 300 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/customer_opt_out_marketing",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "p_phone",
              "value": "={{ $('Es mensaje válido?').item.json.body.data.key.remoteJid.replace('@s.whatsapp.net', '') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-opt-out-db",
      "name": "Registrar Opt-Out en Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 880, 160 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE_NAME }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $('Es mensaje válido?').item.json.body.data.key.remoteJid }}"
            },
            {
              "name": "text",
              "value": "=Entendido! 👍 Removemos seu número da nossa lista de lembretes automáticos.\n\nSe precisar de gás ou água mineral no futuro, é só mandar mensagem por aqui a qualquer momento. Estamos sempre à disposição! 😊"
            }
          ]
        },
        "options": {}
      },
      "id": "http-send-optout-reply",
      "name": "Confirmar Opt-Out WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 1100, 160 ],
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/generate_catalog_session",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "p_phone",
              "value": "={{ $('Es mensaje válido?').item.json.body.data.key.remoteJid.replace('@s.whatsapp.net', '') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-supabase-token",
      "name": "Generate Catalog Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 880, 420 ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.token }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "if-token-valid",
      "name": "Token generado? (Rate Limit Check)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 1080, 420 ]
    },
    {
      "parameters": {
        "amount": "={{ Math.floor(Math.random() * 6) + 4 }}",
        "unit": "seconds"
      },
      "id": "wait-human-delay",
      "name": "Delay Anti-Robot (4-9s)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [ 1280, 400 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE_NAME }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $('Es mensaje válido?').item.json.body.data.key.remoteJid }}"
            },
            {
              "name": "text",
              "value": "=Oi! 👋 Vi sua mensagem.\n\nAcesse o link abaixo para fazer seu pedido direto e com segurança:\n🔗 {{ $env.CATALOG_DOMAIN }}/{{ $('Generate Catalog Token').first().json.token }}\n\nO link é válido por 24 horas. Qualquer dúvida é só chamar! 😊"
            }
          ]
        },
        "options": {}
      },
      "id": "http-send-reply",
      "name": "Enviar Auto-Respuesta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 1480, 400 ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Webhook Evolution API": {
      "main": [
        [
          {
            "node": "Es mensaje válido?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Es mensaje válido?": {
      "main": [
        [
          {
            "node": "Es comando Opt-Out (LGPD)?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Es comando Opt-Out (LGPD)?": {
      "main": [
        [
          {
            "node": "Registrar Opt-Out en Supabase",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Generate Catalog Token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Registrar Opt-Out en Supabase": {
      "main": [
        [
          {
            "node": "Confirmar Opt-Out WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Catalog Token": {
      "main": [
        [
          {
            "node": "Token generado? (Rate Limit Check)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Token generado? (Rate Limit Check)": {
      "main": [
        [
          {
            "node": "Delay Anti-Robot (4-9s)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delay Anti-Robot (4-9s)": {
      "main": [
        [
          {
            "node": "Enviar Auto-Respuesta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "WF-04: Global Error Handler"
  }
}
