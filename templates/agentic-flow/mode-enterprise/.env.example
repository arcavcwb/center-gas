# ==========================================
# MODO ENTERPRISE - PLANE & SCRUM GOVERNANCE
# ==========================================

# 1. Plane.so (Fuente de Verdad del Negocio)
PLANE_API_KEY=plane_api_xxxxxxxxxxxxxxxxxxxxxxxx
PLANE_WORKSPACE_SLUG=tu-workspace
PLANE_PROJECT_ID=00000000-0000-0000-0000-000000000000
PLANE_BASE_URL=https://api.plane.so

# 2. Base de Datos / BaaS (Supabase / Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mi_db
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# 3. Automatizaciones n8n (Opcional)
N8N_API_URL=https://n8n.tu-dominio.com/api/v1
N8N_API_KEY=tu-n8n-api-key

# 4. Configuración de Entorno
NODE_ENV=development
PORT=3000
